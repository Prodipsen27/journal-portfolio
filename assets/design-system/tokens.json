{
  "brand": {
    "name": "Prodip Sengupta",
    "theme": "Vintage Field Journal",
    "voice": "Confident, clean, AI-native engineer"
  },
  "colors": {
    "primitive": {
      "ink": {
        "900": "#110c0a",
        "800": "#20242B",
        "500": "#4B5566",
        "300": "#8C8577"
      },
      "paper": {
        "50": "#FAFAFA",
        "100": "#FBF7EE",
        "200": "#F7F4EB",
        "300": "#EFE6D2",
        "400": "#DCCFAF"
      },
      "crimson": {
        "500": "#9C3B3B",
        "600": "#8C2121",
        "700": "#7A1C1C",
        "900": "#3b1010"
      },
      "emerald": {
        "500": "#3B6B58",
        "800": "#162820"
      },
      "gold": {
        "400": "#FFD700",
        "500": "#B08D3F"
      }
    },
    "semantic": {
      "light": {
        "background": "{colors.primitive.paper.100}",
        "surface": "{colors.primitive.paper.50}",
        "text-main": "{colors.primitive.ink.800}",
        "text-muted": "{colors.primitive.ink.300}",
        "border": "{colors.primitive.paper.400}",
        "primary": "{colors.primitive.crimson.500}",
        "primary-hover": "{colors.primitive.crimson.600}",
        "accent": "{colors.primitive.emerald.500}"
      },
      "dark": {
        "background": "#120F0D",
        "surface": "#1C1F26",
        "text-main": "#E6DFCF",
        "text-muted": "#A69F90",
        "border": "#3f4756",
        "primary": "#E56B6B",
        "primary-hover": "#F07F75",
        "accent": "#55cbb0"
      }
    }
  },
  "typography": {
    "fonts": {
      "serif": "'Lora', Georgia, serif",
      "handwriting": "'Caveat', cursive",
      "typewriter": "'Courier Prime', monospace"
    },
    "sizes": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem"
    }
  }
}
